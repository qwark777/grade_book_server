MYSQL_HOST=db
MYSQL_ROOT_PASSWORD=replace_with_long_random_root_password
MYSQL_USER=gradebook_user
MYSQL_PASSWORD=replace_with_long_random_database_password
MYSQL_DB=grade_book
MYSQL_PORT=3306
INIT_DB_ON_STARTUP=false

APP_HOST=0.0.0.0
APP_PORT=8001
UVICORN_WORKERS=2
BACKEND_CORS_ORIGINS=https://school.example.com
TRUSTED_HOSTS=school.example.com,api.school.example.com

SECRET_KEY=replace_with_openssl_rand_hex_32
ENCRYPTION_KEY=replace_with_python_fernet_key

OWNER_USERNAME=owner
OWNER_PASSWORD=replace_with_long_random_owner_password
OWNER_FULL_NAME="System Owner"

# Email / landing leads
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@gradebook.su
SMTP_FROM_NAME=GradeBook
SMTP_USE_TLS=true
LANDING_LEADS_EMAIL=owner@example.com

MAX_CONCURRENT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=15
RATE_LIMIT_MAX_REQUESTS=500
MAX_WEBSOCKETS_PER_USER=4
REALTIME_REDIS_URL=redis://realtime:6379/0
REALTIME_REDIS_CHANNEL=gradebook:realtime
REALTIME_PRESENCE_TTL_SECONDS=90
REALTIME_BROKER_REQUIRED=true

# School subscription payments
# Manual billing is production-ready while this remains disabled. The only
# supported webhook contract is generic_hmac and needs an external adapter.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_PUBLIC_NAME=
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_WEBHOOK_SECRET=replace_with_provider_webhook_secret
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_SYNC_INTERVAL_SECONDS=3600
