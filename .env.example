# MySQL Database Configuration
# Для локальной разработки используй: MYSQL_HOST=localhost
# Для Docker используй: MYSQL_HOST=db (или не указывай, будет использовано по умолчанию)
MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=change_me_to_a_long_random_value
MYSQL_USER=gradebook_user
# В Docker приложение подключается отдельным пользователем, не root.
MYSQL_PASSWORD=change_me_to_a_long_random_value
MYSQL_DB=grade_book
MYSQL_PORT=3306

# Application Configuration
APP_PORT=8001
UVICORN_WORKERS=2
REALTIME_REDIS_URL=
REALTIME_REDIS_CHANNEL=gradebook:realtime
REALTIME_PRESENCE_TTL_SECONDS=90
REALTIME_BROKER_REQUIRED=false

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=generate_with_python_cryptography_fernet_key

# Owner Account (for first-time setup - автоматически создается при первом запуске)
# ВАЖНО: Измени пароль в продакшене!
OWNER_USERNAME=owner
OWNER_PASSWORD=change_me_to_a_long_random_value
OWNER_FULL_NAME="Test Owner"

# Email / landing leads
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@gradebook.su
SMTP_FROM_NAME=GradeBook
SMTP_USE_TLS=true
LANDING_LEADS_EMAIL=owner@example.com

# School subscription payments
# Manual billing is production-ready while this remains disabled. The only
# supported webhook contract is generic_hmac and needs an external adapter.
PAYMENT_PROVIDER=none
PAYMENT_PROVIDER_PUBLIC_NAME=
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_DAYS=7
SUBSCRIPTION_SYNC_INTERVAL_SECONDS=3600
